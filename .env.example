# Copy to .env and fill in
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# tfidf (default, lightweight) or st (sentence-transformers, semantic)
EMBEDDINGS=tfidf
DB_PATH=data/app.db
MAX_UPLOAD_MB=20
# Set to 1 when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=0
RATE_LIMIT=1
# OCR for scanned PDFs (needs requirements-ocr.txt and the tesseract program)
OCR=0
OCR_LANG=eng
LOG_LEVEL=INFO
